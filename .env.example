# Provider keys -- copy to .env (gitignored). Never commit real values.
# Referenced by tools.yaml / search_engines.yaml / Settings; picked up on the
# next run WITHOUT restart (section 9.2-d, section 11.1). Comma-separated value = a key POOL
# (per-request rotation + per-key quota tracking, section 8 PSV-0).
#
# The pipeline is KEYLESS-FIRST: every module degrades honestly (explicit
# skip line, never silent) when its optional key is absent -- proven in the
# B3 acceptance run #28. Full inventory: docs/api-keys.md.

# ---- Search engines (PSV-0/PSV-1 SEARCH-FORGE pool; all OPTIONAL) --------
# duckduckgo is keyless (default engine). Keyed engines activate per-key.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SERPER_API_KEY=
BRAVE_API_KEY=
SERPAPI_KEY=
YANDEX_XML_KEY=
YANDEX_XML_USER=

# ---- OSINT agents (PSV-3; OPTIONAL -- keyless agents always run) ----------
CHAOS_KEY=

# ---- GitHub OSINT (PSV-7; OPTIONAL -- sub-step skips without it) ----------
# Comma-separated = token pool rotated at 30 req/min (spec section 8 PSV-7).
GITHUB_TOKEN=

# ---- IP discovery (PSV-8; OPTIONAL -- activates only with CIDR/range/ASN
#      includes AND its key present; pure-domain targets skip per spec) ----
CENSYS_API_ID=
CENSYS_API_SECRET=
SHODAN_API_KEY=

# ---- Notifications (the OPERATOR sets ONLY their Telegram username or user
#      id -- in the dashboard SETTINGS panel or per-target in TARGETS; bare
#      handles like jackjohns are accepted as well as 123456789.
#      TELEGRAM_CHAT_ID here is a deployment fallback only. The bot token is
#      platform provisioning: set it once, never needed in daily use. EXTRA
#      comma-separated tokens act as AUTOMATIC BACKUPS: when one is rejected
#      the platform rotates to the next one by itself.) ---------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- C5 IP rotation (optional) --------------------------------------------
#   Comma-separated proxy pool (http/https/socks5). Every entry is
#   health-checked before a run (fail-fast, credentials masked), then
#   discovery steps go out through the entries in turn (round-robin);
#   the per-step assignment ledger lands in each run's
#   logs/proxy-rotation.json. Per-target pools are configured in the
#   TARGETS panel. Leave empty for a direct connection.
# PROXY_POOL=http://user:pass@proxy-a:8080, socks5://proxy-b:1080

# ---- Dashboard auth (optional legacy; first-run uses the on-screen password gate)
# If unset, the dashboard shows a setup page and stores a scrypt hash in
# dashboard/auth/operator.sqlite (not in recon/). CI may still set a token.
# Minimum 8 characters when used; prefer `openssl rand -hex 24`.
DASHBOARD_TOKEN=

# ---- Dashboard process identity (optional; compose interpolates these) ----
# Set to your `id -u` / `id -g` so files written by the dashboard are yours.
# DOCKER_GID is `getent group docker | cut -d: -f3` -- needed for nested docker.
# RECON_HOST_UID=1000
# RECON_HOST_GID=1000
# DOCKER_GID=986

# ---- OSINT APIs (PSV-3b; OPTIONAL keys -- keyless sources always run) -----
SECURITYTRAILS_API_KEY=
VIRUSTOTAL_API_KEY=

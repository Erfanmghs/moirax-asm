{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recon.local/schemas/port-check.schema.json",
  "title": "port-check data.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module", "results", "unreachable", "unique_ips_checked", "duplicates_skipped"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "module": { "type": "string", "const": "port-check" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ip", "hosts", "ports"],
        "properties": {
          "ip": { "type": "string" },
          "hosts": { "type": "array", "items": { "type": "string" } },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["port", "proto", "state"],
              "properties": {
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "proto": { "type": "string" },
                "state": { "type": "string", "const": "open" }
              }
            }
          }
        }
      }
    },
    "unreachable": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unique_ips_checked": { "type": "integer", "minimum": 0 },
    "duplicates_skipped": { "type": "integer", "minimum": 0 },
    "skipped_no_ip": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
